# J.A.R.V.I.S. cloud deployment template.
# Copy the values into Render/Railway environment variables (DO NOT upload this section containing secrets to a repo... and never commit real keys).
# Everything marked ★ must be set or JARVIS will start but degrade gracefully.

# === Cloud bind — REQUIRED so the platform can reach the server ===
HOST=0.0.0.0
# PORT is assigned by the platform (Render/Railway) automatically. Do not set it manually.

# === Access protection — REQUIRED for public deploy ★ ===
# Pick a PIN before deploying. Anyone who visits your URL needs it.
AUTH_PIN=YOUR_PRIVATE_PIN_HERE

# === LLM ★ ===
OPENAI_API_KEY=gsk_YOUR_GROQ_KEY
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.5
LLM_MAX_TOKENS=1024

# === Voice (optional; browser audio streaming needs HTTPS — platforms provide it by default) ===
VOICE_ENABLED=true
WAKE_WORD=hey jarvis
WAKE_ENABLED=false
FISH_AUDIO_API_KEY=
FISH_AUDIO_REFERENCE_ID=
FISH_AUDIO_MODEL=s2.1-pro-free
STT_MODEL=whisper-large-v3-turbo

# === Home location (weather tool) ===
LOCATION_NAME=Guam
LOCATION_LATITUDE=13.4443
LOCATION_LONGITUDE=144.7937

# === Misc ===
TASK_TIMEOUT=3600000
LOG_LEVEL=info